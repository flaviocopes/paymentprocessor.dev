---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";

const providers = (await getCollection("providers")).map((entry) => entry.data).map((provider) => ({
  slug: provider.slug,
  name: provider.name,
  model: provider.model,
  serviceModel: provider.serviceModel,
  stage: provider.stage,
  summary: provider.summary,
  products: provider.products,
  sellerCoverage: provider.sellerCoverage,
  buyerCoverage: provider.buyerCoverage,
  bestFor: provider.bestFor,
  strengths: provider.strengths,
  limitations: provider.limitations,
  pricing: provider.pricing
}));
---

<BaseLayout title="Payment provider matcher — Payment Stack Guide" description="Build a transparent payment-provider shortlist from your legal-seller preference, product, country workload, company stage, priorities, and pricing needs.">
  <PageHeader eyebrow="Interactive shortlist" title="Find providers that fit your shape" description="Answer six practical questions. The matcher explains why each provider surfaced and what you still need to verify." meta={`${providers.length} provider profiles · no sponsored rankings`} />

  <section class="section matcher-section" x-data="providerMatcher()" x-cloak>
    <div class="shell matcher-workspace">
      <form class="matcher-controls" @submit.prevent>
        <div class="matcher-control-heading"><span>Build your scenario</span><button type="button" @click="reset()">Reset</button></div>
        <label>
          <span>Who should be the legal seller?</span>
          <select x-model="inputs.model">
            <option value="open">Show me both models</option>
            <option value="merchant-of-record">The provider — Merchant of Record</option>
            <option value="direct-payments">My company — direct payments</option>
          </select>
        </label>
        <label>
          <span>What are you selling?</span>
          <select x-model="inputs.product">
            <option value="saas">SaaS or subscriptions</option>
            <option value="digital">Digital products or software</option>
            <option value="physical">Physical goods or retail</option>
            <option value="marketplace">Marketplace or platform</option>
            <option value="omnichannel">Online and in-person</option>
            <option value="invoices">Invoices or bank payments</option>
          </select>
        </label>
        <label>
          <span>What stage is the business?</span>
          <select x-model="inputs.scale">
            <option value="solo">Solo or early-stage</option>
            <option value="growing">Growing company</option>
            <option value="enterprise">Enterprise or complex operations</option>
          </select>
        </label>
        <label>
          <span>How heavy is direct-payment administration in your country?</span>
          <select x-model="inputs.administration">
            <option value="unknown">Not assessed yet</option>
            <option value="high">Heavy — outsourcing may justify the fee</option>
            <option value="manageable">Manageable — we can retain the work</option>
          </select>
          <small class="matcher-field-note">Consider VAT, invoicing, filing, accounting, and transaction support for your legal entity—not country stereotypes.</small>
        </label>
        <label>
          <span>What matters most right now?</span>
          <select x-model="inputs.priority">
            <option value="simplicity">Operational simplicity</option>
            <option value="global">Global reach</option>
            <option value="control">Control and flexibility</option>
            <option value="bank">Bank-payment economics</option>
            <option value="omnichannel">Omnichannel commerce</option>
          </select>
        </label>
        <label>
          <span>Do you require a public base formula?</span>
          <select x-model="inputs.pricing">
            <option value="any">No — quote-based is acceptable</option>
            <option value="public">Yes — public pricing preferred</option>
          </select>
        </label>
        <div class="matcher-next-links">
          <a href="/tools/country-checker/">Check your business country →</a>
          <a href="/tools/effective-cost/">Compare modeled costs →</a>
        </div>
      </form>

      <div class="matcher-results" aria-live="polite">
        <div class="matcher-results-heading">
          <div><span class="eyebrow">Your research shortlist</span><h2>Five places to start.</h2></div>
          <p>A fit signal measures alignment with these answers—not quality, approval likelihood, or a recommendation.</p>
        </div>
        <div class="matcher-result-list">
          <template x-for="(provider, index) in matches" :key="provider.slug">
            <article class="matcher-result">
              <div class="matcher-result-rank"><span x-text="String(index + 1).padStart(2, '0')"></span><strong><span x-text="provider.fitSignal"></span><small>/ 100 fit signal</small></strong></div>
              <div class="matcher-result-main">
                <div class="matcher-result-title">
                  <div><span class="model-badge" :class="provider.model === 'merchant-of-record' ? 'model-mor' : 'model-direct'" x-text="provider.model === 'merchant-of-record' ? 'Merchant of Record' : 'You remain the merchant'"></span><h3 x-text="provider.name"></h3></div>
                  <a :href="`/providers/${provider.slug}/`">Open profile →</a>
                </div>
                <ul class="matcher-reasons">
                  <template x-for="reason in provider.reasons" :key="reason"><li x-text="reason"></li></template>
                </ul>
                <p class="matcher-watchout"><strong>Watch:</strong> <span x-text="provider.watchout"></span></p>
              </div>
            </article>
          </template>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-blue">
    <div class="shell note-grid">
      <div><span class="eyebrow eyebrow-inverse">How to use it</span><h2>Shortlist first. Verify second.</h2></div>
      <div class="prose"><p>The matcher uses documented product focus, responsibility model, stage, strengths, limitations, pricing visibility, and your own assessment of retained local administration. It intentionally does not infer complexity from a country name or predict underwriting approval, conversion, support quality, or negotiated commercial terms.</p><a class="button button-light" href="/methodology/">Read the methodology →</a></div>
    </div>
  </section>

  <script is:inline type="application/json" id="matcher-providers" set:html={JSON.stringify(providers)}></script>
  <script>
    import { createProviderMatcher } from "../../../lib/provider-matcher.mjs";
    const element = document.querySelector("#matcher-providers");
    const providerData = element ? JSON.parse(element.textContent || "[]") : [];
    (window as any).providerMatcher = () => createProviderMatcher(providerData);
  </script>
</BaseLayout>
